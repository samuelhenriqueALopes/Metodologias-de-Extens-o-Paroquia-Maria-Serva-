# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# URL pública do site (usada no sitemap e nas metatags)
NEXT_PUBLIC_SITE_URL=https://www.paroquiamariaserva.org.br

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta: só no servidor. Não use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sal para anonimizar IPs (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
IP_HASH_SALT=
