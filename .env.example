# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# URL pública do site (usada no sitemap e nas metatags)
NEXT_PUBLIC_SITE_URL=YOUR_SITE_URL

# Supabase > Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...): substitui a antiga "anon key".
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): substitui a antiga "service_role". Só no servidor; não use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Sal para anonimizar IPs (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
IP_HASH_SALT=
